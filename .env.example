# Two projects share this checkout. Put each value on its own NAME= line.
# A line that starts with # is a comment. The value is not read from a comment.
# Tata Neu / NeuPlan reads GEMINI_API_KEY and GEMINI_MODEL.
# Finlit Ventures reads XAI_API_KEY.
# Do not prefix any of these names with NEXT_PUBLIC_.
# Leave GEMINI_API_KEY and GEMINI_MODEL empty to use the deterministic fallback parser.
# Do not put a real key, or text that looks like a real key, in this file.

XAI_API_KEY=
GEMINI_API_KEY=
# Optional model name goes on the next line, for example gemini-3.5-flash-lite.
GEMINI_MODEL=
