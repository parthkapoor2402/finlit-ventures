# Copy to .env and paste your key. Do not put a real key in this file.
# The Vite server reads XAI_API_KEY. Do not prefix it with VITE_.
# Key: https://console.x.ai/
XAI_API_KEY=
# Optional. Current text model as of October 2026: grok-4.7
XAI_MODEL=grok-4.7
# Optional public pages. Leave blank until a real page exists.
# Do not invent a phone number, email, WhatsApp link, or booking URL.
VITE_FINLIT_CONTACT_URL=
VITE_FINLIT_BOOKING_URL=
