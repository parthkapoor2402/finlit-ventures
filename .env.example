# Copy to .env and paste your key. Do not put a real key in this file.
# The Vite server reads this. Do not prefix it with VITE_.
# A key starting with gsk_ is sent to Groq: https://console.groq.com/keys
# A key starting with xai- is sent to xAI Grok: https://console.x.ai/
XAI_API_KEY=
# Optional. For a gsk_ key the default model is qwen/qwen3.8-27b.
# Set GROQ_MODEL only to another model that this key can call.
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional. Used when the key starts with xai-.
# XAI_MODEL=grok-4.7
# Optional public pages. Leave blank until a real page exists.
# Do not invent a phone number, email, WhatsApp link, or booking URL.
VITE_FINLIT_CONTACT_URL=
VITE_FINLIT_BOOKING_URL=
